# Optional. Defaults to https://volmer.md when unset.
# For local development, set this in .env.development.local.
NEXT_PUBLIC_SITE_URL=https://volmer.md

# Required for appointment availability and creation. Keep the private key server-side.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional together: Telegram notification after a successful appointment booking.
# Keep the bot token server-side. Group/supergroup IDs are usually negative.
TELEGRAM_BOT_TOKEN=8970779361:AAGLESCTGhVVQB51CjifSH8xpncUkfKCG4I
TELEGRAM_CHAT_ID=1185866967

# Optional: HTTPS endpoint that accepts Volmer lead JSON via POST.
# The endpoint and bearer token must both be configured before the lead form can report success.
VOLMER_LEAD_WEBHOOK_URL=
VOLMER_LEAD_WEBHOOK_TOKEN=

# Optional: Telegram username without @; when blank, the public company phone link is used.
NEXT_PUBLIC_TELEGRAM_USERNAME=

# Optional: Google Maps embed/directions overrides.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=
NEXT_PUBLIC_GOOGLE_MAPS_DIRECTIONS_URL=
